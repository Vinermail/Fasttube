{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fasttube",
  "version": "0.1.0",
  "identifier": "com.local.fasttube",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Fasttube",
        "width": 1360,
        "height": 850,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data:; connect-src ipc: http://ipc.localhost; font-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$LOCALDATA/fasttube/cache/**",
          "$LOCALDATA/fasttube/covers/**"]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
